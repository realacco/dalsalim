{
  "expo": {
    "name": "달살림",
    "slug": "dalsalim",
    "platforms": ["ios", "android"],
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "dalsalim",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.dalsalim.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#F4F5FA"
      },
      "backgroundColor": "#F4F5FA",
      "versionCode": 2
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dalsalim.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F4F5FA",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#14151B"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "53442dd2-432f-4dbe-9c20-030e4aeb7f0b"
      }
    },
    "owner": "jongdaepark",
    "backgroundColor": "#F4F5FA",
    "runtimeVersion": "1",
    "updates": {
      "url": "https://u.expo.dev/53442dd2-432f-4dbe-9c20-030e4aeb7f0b"
    }
  }
}
