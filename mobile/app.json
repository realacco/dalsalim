{
  "expo": {
    "name": "달살림",
    "slug": "dalsalim",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "dalsalim",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.dalsalim.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#FBF7F0"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dalsalim.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FBF7F0"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "53442dd2-432f-4dbe-9c20-030e4aeb7f0b"
      }
    },
    "owner": "jongdaepark"
  }
}
