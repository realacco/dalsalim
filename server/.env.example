# 이 파일을 .env 로 복사해서 쓴다.

# Postgres 연결 문자열. Railway 의 Postgres 서비스 > Variables 에서 복사한다.
#   postgresql://<user>:<password>@<host>:<port>/<db>
# ★ SQLite 는 더 이상 쓰지 않는다 — 로컬도 Postgres 로 맞춘다.
#   "내 노트북에선 됐는데"를 없애려는 것이고, 연 고정비의 months(Int[]) 가
#   SQLite 에서는 표현이 안 된다. (기획서 7.4)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dalsalim"
PORT=4000
HOST=0.0.0.0

# 운영에서만 production. 이 값이 production 이면
#  - /auth/dev 라우트가 아예 등록되지 않고
#  - JWT_SECRET 이 기본값이면 서버가 뜨지 않는다
NODE_ENV=development

# 앱이 서버를 부르는 주소. 카카오 redirect_uri 를 이 값으로 만든다.
# 에뮬레이터는 adb reverse 로 localhost 를 그대로 쓴다.
PUBLIC_BASE_URL="http://localhost:4000"

# 운영에서는 반드시 바꾼다. 기본값이면 서버가 아예 안 뜬다.
#   openssl rand -base64 32
JWT_SECRET="dalsalim-dev-secret-change-me"

# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > REST API 키
# 비워두면 개발용 로그인만 동작한다.
KAKAO_REST_API_KEY=""
# 보안 > Client Secret (사용함으로 설정한 경우에만)
KAKAO_CLIENT_SECRET=""

# 배포된 커밋 해시. /health 의 sha 로 나간다. Railway 는 RAILWAY_GIT_COMMIT_SHA 를 알아서 넣어주므로
# 거기서는 비워 둔다. 다른 곳에 올릴 때만 빌드 스크립트가 채운다. 로컬은 비워 두면 null.
GIT_SHA=""

# 정산일 알림 (F-FAM-10) 은 Expo Push Service 로 보낸다. 기본은 토큰 없이도 보내진다.
# expo.dev 의 프로젝트 설정에서 "Enhanced push security" 를 켰을 때만 액세스 토큰을 넣는다.
# 안드로이드 기기까지 닿으려면 FCM 키를 EAS 에 올려야 한다 — README 「푸시 알림」.
EXPO_ACCESS_TOKEN=""
# 정산일 알림 스케줄러. 기본은 켜짐이고 운영에서는 비워 둔다. 같은 DB 에 서버를 둘 띄우거나
# (둘 다 보낸다) 실제로 exp.host 에 닿으면 안 되는 곳에서만 false 로 끈다. 스모크는 시각을 넣어 직접 돌린다.
REMINDERS_ENABLED=""

# 계정 삭제 안내 페이지(GET /account/delete)의 문의 창구. F-SES-08.
# 앱을 이미 지운 사람이 삭제를 요청하는 유일한 길이라 스토어 심사가 실제로 눌러본다.
# 안 넣으면 그 문단이 안 그려진다 — 닿지 않는 주소를 보여주는 것보다 낫다.
# ★ 플레이스토어에 올리기 전에는 반드시 넣는다.
SUPPORT_EMAIL=""

# 카카오 앱 없이 테스트할 수 있는 개발용 로그인.
# 기본값은 꺼짐이다. 개발할 때만 여기서 켠다 — 운영(NODE_ENV=production)에서는 켤 수 없다.
DEV_LOGIN=true
