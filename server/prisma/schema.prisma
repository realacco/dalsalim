// 달살림 데이터 모델
//
// 설계 메모
//  - EntryLine 은 항목의 "그 달 스냅샷"이다. name/category 를 FixedExpense 에서
//    참조하지 않고 복사해 둔다. 나중에 고정비 항목의 이름·분류를 바꿔도 과거 기록이
//    흔들리지 않게 하기 위함이다. (docs/01-MVP-기획서.md 8장)
//  - 금액은 전부 원 단위 정수(Int)로 다룬다. 소수점 없음.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  kakaoId         String?  @unique // 카카오 회원번호
  devKey          String?  @unique // 개발자 로그인 전용 식별자 (DEV_LOGIN=true 일 때만)
  nickname        String
  profileImageUrl String?
  createdAt       DateTime @default(now())

  memberships Membership[]
  pushTokens  PushToken[]
}

model Family {
  id         String   @id @default(cuid())
  name       String
  inviteCode String   @unique // 6자리 대문자+숫자
  createdAt  DateTime @default(now())

  memberships   Membership[]
  fixedExpenses FixedExpense[]
  books         MonthlyBook[]
}

model Membership {
  id          String    @id @default(cuid())
  familyId    String
  userId      String
  displayName String // 가족 안에서 불리는 이름 ("아빠")
  role        String // OWNER | MEMBER
  sortOrder   Int       @default(0)
  joinedAt    DateTime  @default(now())
  /// PENDING | ACTIVE | LEFT
  ///
  ///  - PENDING: 초대코드를 넣었지만 가족장이 아직 승인하지 않은 사람.
  ///    구성원 목록에도, 장부 정원에도 들어가지 않는다. 가족 데이터를 한 줄도 볼 수 없다.
  ///  - ACTIVE: 구성원.
  ///  - LEFT: 나갔거나 내보내진 사람. 실제로 지우지 않는 이유는 MemberEntry 가 Cascade 로
  ///    딸려 나가 과거 장부의 합계가 바뀌기 때문이다. 지난 기록은 그대로 두고 앞으로만 빼낸다.
  status      String    @default("ACTIVE")
  /// 참여를 요청한 시각. 가족장에게 "언제 요청했는지"를 보여준다.
  requestedAt DateTime?
  leftAt      DateTime?

  /// 정산일 알림 (F-FAM-10). 날짜 1~31 · 시 0~23 · 분 0~59, 한국 시간. 셋 다 null 이면 안 받는다.
  /// 구성원의 것이지 사용자의 것이 아니다 — 가족마다 정산일이 다를 수 있고, 가족 탭이 남의 것도 보여준다.
  settlementDay         Int?
  settlementHour        Int?
  settlementMinute      Int?
  /// 마지막으로 정산일 알림을 보낸 달 (YYYY-MM). 같은 달에 두 번 보내지 않기 위한 표시.
  settlementNotifiedFor String?

  family        Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fixedExpenses FixedExpense[]
  entries       MemberEntry[]

  @@unique([familyId, userId])
  @@index([userId])
}

model FixedExpense {
  id            String   @id @default(cuid())
  familyId      String
  membershipId  String // 누구의 고정비인가 — 사람별로 쪼갠다
  name          String
  /// 목록에서 이름 아래 한 줄로 보이는 설명. "엄마 실손 · 2031년 만기" 같은 것.
  ///
  /// EntryLine 에 복사하지 않는다. 이름·분류를 복사하는 이유는 그 둘이 과거 장부의
  /// 표시와 합계를 바꾸기 때문인데, 설명은 금액에도 집계에도 관여하지 않는 힌트라
  /// 오히려 항상 최신인 쪽이 맞다 — "이게 무엇인지"를 알려주는 게 목적이므로.
  description   String?
  category      String // docs/01-MVP-기획서.md 7.4 의 고정 목록
  defaultAmount Int
  dayOfMonth    Int? // 결제일 (1~31, 선택)
  /// 다음 달 위저드 맨 앞에서 "실제로 얼마 썼나"를 되물을 것인가 (기획서 7.4 · F-FIX-07).
  ///
  /// 통신비·보험처럼 그냥 빠져나가는 돈은 나간 금액이 곧 쓴 금액이라 물을 게 없고,
  /// 생활비·용돈처럼 옮겨두고 쓰는 돈만 "옮긴 금액"과 "실제 쓴 금액"이 따로 있다.
  /// 그 구분을 분류가 아니라 항목에 붙인다 — `기타`에 든 용돈만 켜고 잡다한 것은 끄기 위해서다.
  ///
  /// EntryLine 에 복사하지 않는다. 스위치의 효과는 "그 달에 결산 줄이 만들어졌다"는 사실로 남고,
  /// 그 줄 자체가 스냅샷이다 (하드룰 4). 나중에 스위치를 꺼도 이미 만들어진 결산 줄은 그대로다.
  settles       Boolean  @default(false)
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  family     Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  membership Membership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  lines      EntryLine[]

  @@index([familyId])
  @@index([membershipId])
}

/// 가족 × 특정 월. status 는 "전원 제출됨"을 나타내는 표시일 뿐 잠금장치가 아니다. (기획서 3장)
model MonthlyBook {
  id          String    @id @default(cuid())
  familyId    String
  yearMonth   String // 'YYYY-MM'
  status      String    @default("OPEN") // OPEN | COMPLETE
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  family  Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  entries MemberEntry[]

  @@unique([familyId, yearMonth])
}

/// 멤버 1명이 그 달에 작성한 기록.
model MemberEntry {
  id           String    @id @default(cuid())
  bookId       String
  membershipId String
  status       String    @default("DRAFT") // DRAFT | SUBMITTED
  note         String? // 이번 달 특이사항
  cursor       Int       @default(0) // 위저드가 멈춰 있는 스텝 (이어서 작성용)
  submittedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  book       MonthlyBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  membership Membership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  lines      EntryLine[]

  @@unique([bookId, membershipId])
  @@index([membershipId])
}

/// 위저드의 한 줄 = 한 스텝. 지난달 결산 / 수입 / 고정비 / 추가지출.
model EntryLine {
  id             String  @id @default(cuid())
  entryId        String
  kind           String // SETTLEMENT | INCOME | EXTRA_INCOME | FIXED | EXTRA (F-ENT-11 결산 줄은 지난달 줄의 정정 — 합계에서 다르게 센다 · F-ENT-12 기타 수입은 월급에 더해지는 그 달만의 돈)
  fixedExpenseId String? // FIXED 와 SETTLEMENT 일 때. 장기 추이의 근거가 되므로 보존한다 — 고정비 줄인지는 kind 로 가른다
  name           String
  category       String
  /// 기본값. 지난달 실제 금액 → 없으면 고정비 등록 금액. null 이면 첫 달이라 비교 대상이 없다.
  plannedAmount  Int?
  /// 기본값이 어디서 왔는가. 앱이 "지난달과 같아요" / "등록한 금액과 같아요" 를 가려 쓴다.
  /// LAST_MONTH | FIXED_DEFAULT | null
  plannedSource  String?
  /// 사용자가 확정한 금액. null 이면 아직 이 스텝을 지나지 않았다.
  actualAmount   Int?
  /// plannedAmount 와 actualAmount 가 다를 때 필수.
  changeReason   String?
  sortOrder      Int     @default(0)

  entry        MemberEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  fixedExpense FixedExpense? @relation(fields: [fixedExpenseId], references: [id], onDelete: SetNull)

  @@index([entryId])
  @@index([fixedExpenseId])
}

/// 알림을 받을 기기 (F-FAM-10). 사용자의 것이다 — 폰은 가족과 무관하게 사람에게 딸린다.
/// 로그아웃하면 앱이 지우고, Expo 가 "이 기기는 없다"고 답해도 지운다.
/// 세션이 만료된(401) 폰은 못 지운다 — 인증이 없어 서버에 말할 수 없다. 그 폰은 알림을 받고 눌러 로그인하면
/// 다시 등록되며 주인이 갈아끼워진다. 만료 자체가 드문 경로(90일)라 그대로 둔다.
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  /// ExponentPushToken[...] — 기기마다 하나
  token     String   @unique
  /// android | ios
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
